+        
+        # Update wind position based on yaw and pitch with fixed radius
+        setup_wind_position(center_xyz, yaw, pitch, wind_name, fixed_radius)
+        
+        # Set wind strength
+        wind_obj.field.strength = strength
+        
+        # Insert keyframes for position and strength
+        wind_obj.keyframe_insert(data_path="location", frame=frame_num)
+        wind_obj.keyframe_insert(data_path="rotation_euler", frame=frame_num)
+        wind_obj.keyframe_insert(data_path="field.strength", frame=frame_num)
+    
+    print(f"Applied {len(wind_trace['frames'])} keyframes to wind object {wind_name}")
+    bpy.context.view_layer.update()
 
