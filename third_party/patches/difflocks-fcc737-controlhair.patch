+    if fixed_radius < 1e-4:
+        fixed_radius = 10.0  # Default radius
+    
+    print(f"Using fixed radius {fixed_radius:.2f} for wind object {wind_name}")
+    
+    # Apply keyframes for each frame
+    for frame_data in wind_trace['frames']:
+        frame_num = frame_data['frame']
+        yaw = frame_data['yaw']
+        pitch = frame_data['pitch']
+        strength = frame_data['strength']
+        
+        # Set the frame
