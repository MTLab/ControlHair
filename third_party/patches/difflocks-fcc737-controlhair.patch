+def setup_wind_position(center_xyz, yaw_deg, pitch_deg=0, wind_name='Wind', fixed_radius=None):
+    """Move wind to specific yaw and pitch angles relative to scalp center and orient it toward the scalp"""
+    # Get wind object
+    wind_obj = bpy.data.objects.get(wind_name)
+    if wind_obj is None:
+        print(f"Warning: {wind_name} object not found")
+        return
+    
+    # Get center and determine radius
+    cx, cy, cz = center_xyz
+    
+    if fixed_radius is not None:
+        # Use provided fixed radius
+        wind_r = fixed_radius
+    else:
+        # Calculate current wind radius (including z-axis)
+        wind_r = math.sqrt((wind_obj.location.x - cx)**2 + (wind_obj.location.y - cy)**2 + (wind_obj.location.z - cz)**2)
+        # Use default radius if current radius is too small
+        if wind_r < 1e-4:
+            wind_r = 10.0  # Default radius
+    
+    # Convert angles to radians
+    initial_theta = -math.pi / 2  # -Y方向对应角度为-π/2
+    target_theta = initial_theta + math.radians(yaw_deg)
+    pitch_rad = math.radians(pitch_deg)
+    
+    # Calculate position with both yaw and pitch
+    # Yaw rotation around Z-axis, pitch rotation affects height
+    wind_x = cx + wind_r * math.cos(target_theta) * math.cos(pitch_rad)
+    wind_y = cy + wind_r * math.sin(target_theta) * math.cos(pitch_rad)
+    wind_z = cz + wind_r * math.sin(pitch_rad)   
+    
+    wind_obj.location = Vector((wind_x, wind_y, wind_z))
+    
+    # Calculate direction vector from wind to center (scalp)
+    direction = Vector((cx - wind_x, cy - wind_y, cz - wind_z))
+    
+    # Normalize the direction vector
+    if direction.length > 0:
+        direction.normalize()
+    else:
+        print("Warning: Wind is at the same position as center, cannot orient toward scalp")
+        return
+    
+    # Based on observation: wind blows in +Z direction in this setup
+    # Orient the wind object so its +Z axis points toward the scalp
+    track_quat = direction.to_track_quat('Z', 'Y')
+    wind_obj.rotation_euler = track_quat.to_euler()
+    
+    print(f"Wind oriented using Z track axis (confirmed wind direction)")
+    
+    print(f"Wind moved to yaw {yaw_deg}° pitch {pitch_deg}° at position ({wind_x:.2f}, {wind_y:.2f}, {wind_z:.2f}) and oriented toward scalp")
+    
+    bpy.context.view_layer.update()
+
