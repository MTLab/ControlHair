+def generate_sudden_wind_traces(num_frames=81, num_traces=1, add_wind=False):
+    """
+    Generate a single wind trace with two sudden gust intervals.
+    - Strength is 30 during 20%-30% and 70%-80% of frames, else 0.
+    - Yaw and pitch are constant for the whole sequence.
+
+    Args:
+        num_frames: Number of frames to generate (default 81)
+        num_traces: Ignored; always generate exactly one trace
+        add_wind: Ignored
+
+    Returns:
+        List with one trace containing per-frame wind conditions
+    """
+    traces = []
+
+    # Random but constant direction across all frames
+    trace_yaw = 90
+    trace_pitch = 0
+
+    trace_frames = []
+
+    for frame_idx in range(num_frames):
+        frame_number = frame_idx + 1  # Blender frames start at 1
+        ratio = frame_number / float(num_frames)
+
+        if (ratio>= 0.2 and ratio <= 0.4) or (ratio >= 0.7 and ratio <= 0.9):
+            frame_strength = 10.0
+        else:
+            frame_strength = -5.0
+
+        trace_frames.append({
+            'frame': frame_number,
+            'yaw': trace_yaw,
+            'pitch': trace_pitch,
+            'strength': frame_strength
+        })
+
+    traces.append({
+        'trace_id': 0,
+        'frames': trace_frames
+    })
+    
+   
+
+    return traces
