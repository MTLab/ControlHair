+        return None
+    
+    try:
+        pbone = arm_obj.pose.bones[bone_name]
+    except KeyError:
+        print(f"Warning: Pose bone {bone_name} not found on {obj_name}; skipping head motion")
+        return None
+    
+    # Ensure quaternion mode
