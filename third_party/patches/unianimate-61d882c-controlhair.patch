+def load_training_frames(path_dir, pickle_name, video_name):
+    pickle_path = os.path.join(path_dir, pickle_name)
+    if os.path.isfile(pickle_path):
+        with open(pickle_path, "rb") as handle:
+            return pickle.load(handle)
+
+    video_path = os.path.join(path_dir, video_name)
+    if not os.path.isfile(video_path):
+        raise FileNotFoundError(
+            f"Missing both {pickle_name} and {video_name} in {path_dir}"
+        )
+    reader = imageio.get_reader(video_path)
+    try:
+        frames = {
+            f"{index:06d}": np.asarray(frame)
+            for index, frame in enumerate(reader)
+        }
+    finally:
+        reader.close()
+    if not frames:
+        raise RuntimeError(f"No frames decoded from {video_path}")
+    return frames
+
+
+def frame_to_pil(frame):
+    if isinstance(frame, (bytes, bytearray, memoryview)):
+        with Image.open(BytesIO(frame)) as image:
+            return image.convert("RGB").copy()
+    return Image.fromarray(np.asarray(frame)).convert("RGB")
+
