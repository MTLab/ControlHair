+                        "inpaint_embedding.",
+                        "learn_in_embedding.",
+                    )):
+                        self.state_dict_new_module[key] = value
+                    elif key.startswith("pipe.dit.") and "lora" in key:
+                        self.state_dict_new[key.removeprefix("pipe.dit.")] = value
+
+                if not is_final:
+                    return
+                if not self.state_dict_new:
+                    raise ValueError(
+                        f"No LoRA tensors found in sharded training checkpoint: {file_path}"
+                    )
+
+                for model_name, model, model_path in zip(self.model_name, self.model, self.model_path):
