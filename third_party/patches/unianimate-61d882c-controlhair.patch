+                            is_loaded = True
+                            break
+                    if is_loaded:
+                        break
+
+                if not is_loaded:
+                    raise ValueError(
+                        f"Cannot load composed LoRA from sharded training checkpoint: {file_path}"
+                    )
+                print(
+                    f"    Loaded {len(self.state_dict_new)} LoRA tensors and "
+                    f"{len(self.state_dict_new_module)} conditioning tensors."
+                )
+                return
